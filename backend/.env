# backend/.env

NODE_ENV=development
PORT=5000

# MongoDB — use Atlas URI or local
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/p2p_lending?retryWrites=true&w=majority

# JWT — generate a long random string (never expose this)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Stripe (Week 2) — get from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# CORS
CLIENT_URL=http://localhost:5173